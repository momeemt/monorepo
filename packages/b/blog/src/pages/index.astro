---
import { getCollection } from 'astro:content';
import { HomePage } from '../components/Blog';
import Layout from '../layouts/Layout.astro';
import { findAuthor } from '../lib/authors';
import { thumbnailPath } from '../lib/thumbnails';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const postItems = posts.map((post) => ({
  category: post.data.category,
  href: `/posts/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString(),
  thumbnail: thumbnailPath(post.data.thumbnail, post.id),
  author: findAuthor(post.data.author)
}));
---

<Layout>
  <HomePage posts={postItems} />
  <script>
    const description = document.querySelector<HTMLElement>('.siteDescription');
    const comments = JSON.parse(description?.dataset.comments ?? '[]') as string[];

    if (description && !description.dataset.commentReady && comments.length > 0) {
      description.textContent = comments[Math.floor(Math.random() * comments.length)];
      description.dataset.commentReady = 'true';
      description.removeAttribute('data-comment-pending');
    }
  </script>
</Layout>
