---
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  authorName?: string;
}

const {
  title = 'blog.momee.mt',
  description = 'momeemtのブログ',
  image = '/shigureni/smoking-girl.webp',
  imageAlt = title,
  type = 'website',
  authorName
} = Astro.props;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
const rssUrl = new URL('/rss.xml', Astro.site ?? Astro.url).href;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100;300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.2.0/css/all.min.css"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="blog.momee.mt" />
    {authorName && <meta property="article:author" content={authorName} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="alternate" type="application/rss+xml" title="blog.momee.mt" href={rssUrl} />
    <title>{title}</title>
    <style is:inline>
      .siteDescription[data-comment-pending] {
        visibility: hidden;
      }

      .homePage[data-view="card"] .postRows,
      .homePage[data-view="list"] .postGrid {
        display: none;
      }

      .postCard {
        position: relative;
        overflow: hidden;
        border-radius: 15px;
        background-color: white;
      }

      .postThumbnail {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #f7f7f7;
      }

      .postCard .postThumbnail {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 45%;
        padding: 10px;
        border-radius: 15px 15px 0 0;
      }

      .postThumbnail > img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
      }

      .postThumbnail > img[data-loaded="false"] {
        opacity: 0;
      }

      .postThumbnail > img[data-loaded="true"] {
        opacity: 1;
      }

      .categoryBadge {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 24px;
        padding: 0 10px;
        border-radius: 24px;
        color: white;
        font-size: 12px;
        font-weight: 500;
        line-height: 1;
      }

      .categoryBadge.tech {
        background: #f0a23a;
      }

      .categoryBadge.life {
        background: #a5c93a;
      }

      .categoryBadge.cs {
        background: #43b9d8;
      }

      .postAuthor {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #666;
        font-size: 11px;
        line-height: 1;
      }

      .postAuthor img {
        width: 22px;
        height: 22px;
        border-radius: 999px;
        object-fit: cover;
      }

      .postCard .postAuthor {
        position: absolute;
        bottom: 14px;
        left: 16px;
        z-index: 1;
        padding: 4px 8px 4px 4px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
      }
    </style>
    <style is:global>
      html {
        font-family: "Noto Sans JP", sans-serif;
        font-weight: 300;
        background-color: #eee;
      }

      body {
        display: flex;
        justify-content: center;
        width: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        color: #444;
      }

      main,
      .homePage {
        width: 100%;
      }

      .homePage {
        overflow-x: hidden;
      }

      .articlePage {
        width: 80%;
        max-width: 1000px;
        margin: 80px auto;
      }

      .articleContent {
        counter-reset: theorem;
        margin-top: 40px;
        padding: 2em 4em;
        border-radius: 16px;
        background-color: white;
      }

      h1 {
        padding-bottom: 12px;
        border-bottom: 1.5px #ddd solid;
        font-size: 28px;
        font-weight: 400;
      }

      h2 {
        margin: 0.8em 0 0.4em;
        padding: 0;
        font-size: 24px;
        font-weight: 400;
      }

      h3 {
        margin: 0.8em 0 0.4em;
        padding: 0;
        font-size: 20px;
        font-weight: 400;
      }

      hr {
        border: none;
        border-bottom: 0.05em #ddd solid;
      }

      p {
        margin: 0.8em 0;
        font-size: 16px;
        line-height: 28px;
      }

      a {
        color: gray;
        font-size: 16px;
        text-decoration: underline;
      }

      sup a {
        font-size: 14px;
        text-decoration: none;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .footnotes {
        margin-top: 3em;
        padding-top: 1em;
        border-top: 1px solid #ddd;
        color: gray;
      }

      .footnotes p {
        font-size: 14px;
        line-height: 1.4;
      }

      .footnotes a {
        font-size: 14px;
        line-height: 1.0;
        word-break: break-all;
      }

      .footnotes ol {
        padding-left: 1.5em;
      }

      .articleContent img {
        width: 100%;
      }

      .siteTitle {
        margin: 80px 0 0;
        border: none;
        text-align: center;
        word-break: auto-phrase;
      }

      .siteDescription {
        max-width: calc(100% - 40px);
        margin: 0 auto;
        color: gray;
        font-size: 14px;
        text-align: center;
        overflow-wrap: anywhere;
        word-break: auto-phrase;
        line-height: 1.4;
      }

      .siteDescription[data-comment-pending] {
        visibility: hidden;
      }

      .sectionDivider {
        position: relative;
        z-index: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: min(calc(100vw - 64px), 1240px);
        margin: 36px auto 20px;
        color: gray;
      }

      .sectionDivider::before {
        position: absolute;
        top: 50%;
        left: 0;
        z-index: -1;
        width: 100%;
        margin: auto;
        border-bottom: 2px solid gray;
        content: "";
      }

      .sectionDividerLabel {
        position: relative;
        z-index: 1;
        padding: 0 20px;
        background: #eee;
        font-size: 18px;
      }

      .sectionDividerLabel i {
        margin-right: 8px;
      }

      .postList {
        width: min(calc(100vw - 64px), 1240px);
        margin: 0 auto;
      }

      .postGrid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px;
      }

      .homePage[data-view="list"] .postGrid,
      .homePage[data-view="card"] .postRows {
        display: none;
      }

      .homePage[data-view="list"] .postList {
        width: min(calc(100vw - 64px), 760px);
      }

      .viewSwitcher {
        display: flex;
        justify-content: center;
        gap: 8px;
        width: min(calc(100vw - 64px), 1240px);
        margin: 0 auto 20px;
      }

      .viewSwitcher button {
        min-width: 72px;
        padding: 6px 14px;
        border: 1px solid #cfcfcf;
        border-radius: 999px;
        background: transparent;
        color: gray;
        font: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .viewSwitcher button.active {
        border-color: gray;
        background: white;
        color: #444;
      }

      .postCard {
        position: relative;
        width: 100%;
        height: 320px;
        margin: 0 0 24px;
        overflow: hidden;
        border-radius: 15px;
        background-color: white;
        transition: 0.8s;
      }

      .postCard:hover {
        box-shadow: 10px 10px 30px 0 rgba(105, 105, 105, 0.3);
      }

      .postCard a {
        display: inline-block;
        width: 100%;
        height: 100%;
        color: inherit;
        text-decoration: none;
      }

      .postThumbnail {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #f7f7f7;
      }

      .postCard .postThumbnail {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 45%;
        padding: 10px;
        border-radius: 15px 15px 0 0;
      }

      .postThumbnail > img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
      }

      .postThumbnail > img[data-loaded="false"] {
        opacity: 0;
      }

      .postThumbnail > img[data-loaded="true"] {
        opacity: 1;
      }

      .categoryBadge {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 24px;
        padding: 0 10px;
        border-radius: 24px;
        color: white;
        font-size: 12px;
        font-weight: 500;
        line-height: 1;
      }

      .categoryBadge.tech {
        background: #f0a23a;
      }

      .categoryBadge.life {
        background: #a5c93a;
      }

      .categoryBadge.cs {
        background: #43b9d8;
      }

      .postAuthor {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #666;
        font-size: 11px;
        line-height: 1;
        white-space: nowrap;
      }

      .postAuthor img {
        display: block;
        width: 22px;
        height: 22px;
        border-radius: 999px;
        object-fit: cover;
      }

      .postCard .postAuthor {
        position: absolute;
        bottom: 14px;
        left: 16px;
        z-index: 1;
        padding: 4px 8px 4px 4px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
      }

      .postCard .postBody {
        position: absolute;
        top: 45%;
        right: 0;
        bottom: 0;
        left: 0;
        padding: 20px 20px 58px;
      }

      .postCard .postBody h2 {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        margin: 0;
        padding: 0;
        color: black;
        font-size: 20px;
        font-weight: 400;
        line-height: 140%;
      }

      .postCard .postDescription {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        margin: 8px 0 0;
        padding: 0;
        color: gray;
        font-size: small;
        line-height: 140%;
      }

      .postCard .postDate {
        position: absolute;
        right: 20px;
        bottom: 20px;
        margin: 0;
        padding: 0;
        color: gray;
        font-size: small;
        text-align: right;
      }

      .postRows {
        display: grid;
        margin-top: 40px;
        border-top: 1px solid #d6d6d6;
      }

      .postRow {
        overflow: hidden;
        border-bottom: 1px solid #d6d6d6;
        transition: 0.8s;
        background: white;
        padding: 0 20px;
        /* width: 150%; */
      }

      .postRow a {
        display: block;
        padding: 22px 0;
        color: inherit;
        text-decoration: none;
      }

      .postRow h2 {
        margin: 8px 0 0;
        padding: 0;
        color: #222;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.4;
      }

      .postRow .postDescription {
        margin: 6px 0 0;
        color: gray;
        font-size: 12px;
        line-height: 1.6;
      }

      .postRowMeta {
        display: flex;
        flex-wrap: wrap;
        gap: 0px 10px;
        margin: 0;
        color: gray;
        font-size: 12px;
        line-height: 1.4;
      }

      .postRowMeta span,
      .postRowMeta time {
        font-size: inherit;
      }

      .postRowCategory.tech {
        color: #d88723;
      }

      .postRowCategory.life {
        color: #7fa01f;
      }

      .postRowCategory.cs {
        color: #1687a7;
      }

      .articleHeader {
        text-align: center;
      }

      .articleHeader h1 {
        margin-bottom: 10px;
        padding: 0 2em 0;
        border: none;
        font-weight: 500;
      }

      .articleDescription {
        margin: 0;
        padding: 0 1em;
        font-size: 14px;
      }

      .articleDate {
        margin: 0;
        padding: 0 1em;
        color: gray;
        font-size: 14px;
      }

      .articleAuthor {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        color: #444;
        text-align: left;
        padding: 0 1em;
      }

      .articleAuthorIcon {
        display: block;
        width: 52px;
        height: 52px;
        border-radius: 999px;
        object-fit: cover;
      }

      .articleAuthor > span {
        display: grid;
        justify-items: start;
        gap: 3px;
      }

      .articleAuthor strong {
        display: block;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.4;
      }

      .articleAuthorLinks {
        display: inline-flex;
        align-items: center;
        gap: 0px;
      }

      .articleAuthorLinks a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        color: gray;
        font-size: 14px;
        text-decoration: none;
      }

      .articleAuthorLinks a:hover {
        color: #444;
      }

      .articleAuthorBio {
        display: block;
        color: gray;
        font-size: 12px;
        line-height: 1.5;
      }

      .articleTags {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 28px;
        padding-bottom: 24px;
        border-bottom: 1px solid #e5e5e5;
      }

      .articleTagsLabel {
        margin-right: 2px;
        color: #777;
        font-size: 13px;
        font-weight: 500;
        line-height: 1;
      }

      .articleTagLink {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 2px 14px;
        border: 1px solid #d8d8d8;
        border-radius: 999px;
        background: #f8f8f8;
        color: #555;
        font-size: 13px;
        line-height: 1.2;
        text-decoration: none;
      }

      .articleTagLink:hover {
        border-color: #777;
        background: #444;
        color: white;
      }

      .siteFooter {
        margin: 80px 0;
        color: gray;
        font-size: 14px;
        text-align: center;
      }

      .siteFooter a {
        font-size: 14px;
      }

      .siteFooter small {
        margin: 1em 0;
      }

      .footerSeparator {
        margin: 0 0.35em;
      }

      code,
      pre {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      pre {
        margin: 1.25rem 0;
        padding: 1rem;
        overflow-x: auto;
        border: 1px solid #ddd;
        border-radius: 8px;
      }

      :not(pre) > code {
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
        background: #f7f7f7;
      }

      .astro-code {
        background: #f7f7f7 !important;
      }

      .astro-code[data-language="automaton"] {
        background: transparent !important;
      }

      .graphvizDiagram {
        margin: 1.5rem 0;
        padding: 1rem;
        overflow-x: auto;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #f7f7f7;
      }

      .graphvizDiagramAutomaton {
        background: transparent;
        border: 0;
      }

      .graphvizDiagramSvg {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 0 auto;
      }

      .theoremBox {
        margin: 1.5rem 0;
        padding: 1rem 1.2rem;
        border: 1px solid #d9e1e5;
        border-left: 4px solid #43b9d8;
        border-radius: 8px;
        background: #fbfdfe;
      }

      .theoremBox-proof {
        border-color: #ddd;
        border-left-color: #777;
        background: #fff;
      }

      .theoremBox-statement {
        counter-increment: theorem;
      }

      .theoremBoxHeader {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem;
        margin: 0 0 0.65rem;
        color: #222;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.4;
      }

      .theoremBoxType {
        letter-spacing: 0;
      }

      .theoremBox-statement .theoremBoxType::after {
        content: " " counter(theorem);
      }

      .theoremBoxTitle::before {
        color: #777;
        content: "(";
      }

      .theoremBoxTitle::after {
        color: #777;
        content: ")";
      }

      .theoremBoxBody > :first-child {
        margin-top: 0;
      }

      .theoremBoxBody > :last-child {
        margin-bottom: 0;
      }

      .embedFrame,
      .articleContent > iframe[src*="open.spotify.com/embed"] {
        display: block;
        width: 100%;
        margin: 1.5rem 0;
        overflow: hidden;
        border: 0;
        border-radius: 12px;
        background: #f7f7f7;
      }

      .embedFrame iframe,
      .articleContent > iframe[src*="open.spotify.com/embed"] {
        display: block;
        width: 100%;
        border: 0;
        border-radius: 12px;
      }

      .twitterEmbed {
        display: flex;
        justify-content: center;
        width: 100%;
        margin: 1.5rem 0;
      }

      .twitterEmbed .twitter-tweet {
        margin: 0 auto !important;
      }

      .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
      }

      @media screen and (max-width: 1024px) {
        .postGrid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media screen and (max-width: 600px) {
        .articlePage {
          width: 100%;
          max-width: 1000px;
          margin: 80px 0;
        }

        .articleContent {
          margin-top: 40px;
          padding: 2em;
          border-radius: 0;
        }

        .sectionDivider,
        .viewSwitcher {
          width: 80vw;
        }

        .postList {
          width: 80vw;
        }

        .postGrid {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .postCard {
          width: 100%;
        }

        .postRow a {
          grid-template-columns: 116px minmax(0, 1fr);
        }

        .postRow .postBody {
          padding: 18px;
        }

        .postList {
          margin-left: 0;
          margin-right: 0;
          width: 100vw;
        }
        .postGrid {
          padding-left: 10vw;
          padding-right: 10vw;
        }
        .postRows {
          width: 100vw;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
      <script>
        document.querySelectorAll<HTMLElement>('.homePage').forEach((home) => {
          if (home.dataset.viewControllerReady) return;

          home.dataset.viewControllerReady = 'true';
          home.querySelectorAll<HTMLButtonElement>('[data-view-option]').forEach((button) => {
            button.addEventListener('click', () => {
              const view = button.dataset.viewOption;
              if (!view) return;

              home.dataset.view = view;
              home.querySelectorAll<HTMLButtonElement>('[data-view-option]').forEach((item) => {
                const active = item === button;
                item.classList.toggle('active', active);
                item.setAttribute('aria-pressed', String(active));
              });
            });
          });
        });

        document.querySelectorAll<HTMLImageElement>('.postThumbnail > img[data-loaded="false"]').forEach((image) => {
          const reveal = () => {
            image.dataset.loaded = 'true';
          };

          if (image.complete && image.naturalWidth > 0) {
            reveal();
          } else {
            image.addEventListener('load', reveal, { once: true });
          }
        });

        if (document.querySelector('.twitter-tweet') && !document.querySelector('script[data-twitter-widgets]')) {
          const script = document.createElement('script');
          script.async = true;
          script.charset = 'utf-8';
          script.dataset.twitterWidgets = 'true';
          script.src = 'https://platform.x.com/widgets.js';
          document.head.append(script);
        }
      </script>
    </main>
  </body>
</html>
